PORT=3001
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=2h
# Local development defaults to data/stockwise.db (SQLite).
# For production, set DATABASE_URL to a PostgreSQL connection string.
# DATABASE_URL=postgresql://user:password@host:5432/stockwise
# SQLITE_PATH=data/stockwise.db

# PostgreSQL tables live in this isolated schema.
DATABASE_SCHEMA=stockwise
